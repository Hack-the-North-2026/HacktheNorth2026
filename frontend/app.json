{
  "expo": {
    "name": "Fit Stealer",
    "slug": "frontend",
    "scheme": "fit-stealer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050509",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitstealer.app"
    },
    "android": {
      "package": "com.fitstealer.app",
      "adaptiveIcon": {
        "backgroundColor": "#050509",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fit Stealer needs access to your photos so you can upload a screenshot of an outfit.",
          "cameraPermission": "Fit Stealer needs camera access to capture an outfit to identify."
        }
      ],
      "@sentry/react-native",
      "./modules/android-screen-identify/app.plugin.js"
    ]
  }
}
